{
  "info": {
    "name": "EventPulse API",
    "description": "Backend API for Event Management Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://decilvl4.vercel.app"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@email.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventpulse.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/events?search=&page=1&limit=10&sortBy=date&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                { "key": "search", "value": "", "description": "Search in title/description" },
                { "key": "category", "value": "", "description": "Filter by category ID" },
                { "key": "city", "value": "", "description": "Filter by city" },
                { "key": "startDate", "value": "", "description": "Start date filter" },
                { "key": "endDate", "value": "", "description": "End date filter" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "date", "description": "date, capacity, or registrations" },
                { "key": "order", "value": "asc", "description": "asc or desc" }
              ]
            }
          }
        },
        {
          "name": "Get Event by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/:id"
          }
        },
        {
          "name": "Create Event (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/events",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Event\",\n  \"description\": \"Event description\",\n  \"category\": \"categoryId\",\n  \"date\": \"2026-12-01T10:00:00\",\n  \"city\": \"Cairo\",\n  \"venue\": \"Test Venue\",\n  \"capacity\": 100\n}"
            }
          }
        },
        {
          "name": "Update Event (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/events/:id",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Event Title\"\n}"
            }
          }
        },
        {
          "name": "Delete Event (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/events/:id",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for Event",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/registrations",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"eventId\"\n}"
            }
          }
        },
        {
          "name": "My Registrations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/registrations/my",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Cancel Registration",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/registrations/:id",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Announcements",
      "item": [
        {
          "name": "Send Announcement (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/announcements",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"eventId\",\n  \"text\": \"Important announcement!\"\n}"
            }
          }
        },
        {
          "name": "Get Announcements",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/announcements/:eventId"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
