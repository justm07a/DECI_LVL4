{
  "info": {
    "name": "EventPulse API",
    "description": "Backend API for Event Management Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@email.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventpulse.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events"
          }
        },
        {
          "name": "Get Event by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/:id"
          }
        },
        {
          "name": "Create Event (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/events",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Event\",\n  \"description\": \"Event description\",\n  \"category\": \"categoryId\",\n  \"date\": \"2026-12-01T10:00:00\",\n  \"city\": \"Cairo\",\n  \"venue\": \"Test Venue\",\n  \"capacity\": 100\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for Event",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/registrations",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"eventId\"\n}"
            }
          }
        },
        {
          "name": "My Registrations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/registrations/my",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Announcements",
      "item": [
        {
          "name": "Send Announcement (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/announcements",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"eventId\",\n  \"text\": \"Important announcement!\"\n}"
            }
          }
        },
        {
          "name": "Get Announcements",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/announcements/:eventId"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
